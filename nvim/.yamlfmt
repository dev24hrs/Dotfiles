# .yamlfmt

# 路径匹配模式（支持 ** 递归通配）
match_type: doublestar

# 自动遵循 .gitignore
gitignore_excludes: true

# 排除路径
exclude:
  - vendor/**
  - node_modules/**
  - .git/**
  - venv/**
  - .venv/**
  - __pycache__/**
  - dist/**
  - build/**
  - .github/workflows/**
  - '**/charts/**'
  - '**/.terraform/**'
  - '**/generated/**'

# 扩展名
extensions:
  - yaml
  - yml

# 格式化器配置
formatter:
  type: basic

  # 缩进
  indent: 2

  # 行格式
  max_line_length: 120
  line_ending: lf
  trim_trailing_whitespace: true
  eof_newline: true

  # 空行：保留有意义的空行，连续多行合并为一行
  retain_line_breaks: true
  retain_line_breaks_single: true
